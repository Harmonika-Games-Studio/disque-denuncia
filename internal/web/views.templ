package web

import (
	"strconv"

	"disque-denuncia/internal/store"
)

templ base(title string) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="referrer" content="no-referrer"/>
			<title>{ title }</title>
			<meta name="htmx-config" content={ htmxConfig }/>
			<script src="/static/htmx.min.js"></script>
			<style>
				body { font: 16px/1.5 system-ui, sans-serif; max-width: 44rem; margin: 2rem auto; padding: 0 1rem; color: #222; }
				nav { display: flex; gap: 1rem; margin-bottom: 1rem; }
				table { width: 100%; border-collapse: collapse; }
				td, th { padding: .45rem; border-bottom: 1px solid #ddd; text-align: left; vertical-align: top; }
				label { display: block; font-weight: 600; margin: 1rem 0 .3rem; }
				select, textarea, input[type=file] { width: 100%; box-sizing: border-box; padding: .45rem; font: inherit; }
				textarea { min-height: 12rem; }
				button { margin-top: 1rem; padding: .55rem 1.2rem; font: inherit; cursor: pointer; }
				button:disabled { opacity: .5; cursor: wait; }
				#flash:empty { display: none; }
				#flash { padding: .6rem; background: #fdecea; border-left: 3px solid #c0392b; }
				.garantias { background: #f4f7f4; border-left: 3px solid #4a8f3c; padding: .8rem 1rem; }
				.garantias p { margin: 0; }
				.garantias li { margin: .35rem 0; }
				details { margin-top: .6rem; }
				summary { cursor: pointer; color: #2e6b24; font-weight: 600; }
				#progresso { margin-top: 1rem; display: flex; gap: .6rem; align-items: center; }
				#progresso[hidden] { display: none; }
				#progresso progress { flex: 1; }
				.ok { background: #f4f7f4; border-left: 3px solid #4a8f3c; padding: 1rem; }
				.descricao { white-space: pre-wrap; background: #f6f6f6; padding: .8rem; }
				.anexos img { max-width: 100%; margin: .5rem 0; border: 1px solid #ddd; }
				small, .muted { color: #666; }
			</style>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ Flash(msg string) {
	{ msg }
}

// --- página pública ---

templ FormularioPage(cfg Config) {
	@base("Canal de denúncia · " + cfg.Empresa) {
		<h1>Canal de denúncia · { cfg.Empresa }</h1>
		@Garantias(cfg)
		<div id="canal">
			<p id="flash" role="alert"></p>
			<form
				id="form-denuncia"
				action="/denuncias"
				method="post"
				enctype="multipart/form-data"
				data-max-total={ strconv.Itoa(store.MaxTotal) }
				data-max-arquivos={ strconv.Itoa(store.MaxArquivos) }
				data-max-rotulo={ store.RotuloTamanho(store.MaxTotal) }
			>
				<label for="categoria">Assunto</label>
				<select id="categoria" name="categoria" required>
					<option value="">Escolha…</option>
					for _, c := range store.Categorias {
						<option value={ c.Valor }>{ c.Rotulo }</option>
					}
				</select>
				<label for="descricao">O que aconteceu?</label>
				<textarea
					id="descricao"
					name="descricao"
					required
					minlength={ strconv.Itoa(store.DescricaoMin) }
					maxlength={ strconv.Itoa(store.DescricaoMax) }
					placeholder="Conte o que aconteceu, onde e quando, e quem estava envolvido."
				></textarea>
				<label for="arquivos">Arquivos (opcional): fotos, prints, documentos, vídeos ou áudios, até { store.RotuloTamanho(store.MaxTotal) } no total</label>
				<input id="arquivos" type="file" name="arquivos" multiple/>
				<small>Fotos, vídeos, áudios, PDF e documentos do Office perdem os metadados aqui. Outros tipos vão como estão: veja “Saiba mais”.</small>
				<div id="progresso" hidden>
					<progress max="100" value="0"></progress>
					<span></span>
				</div>
				<button type="submit">Enviar denúncia</button>
			</form>
		</div>
		<script src="/static/canal.js"></script>
	}
}

// Garantias é o que o canal promete, em uma frase, com os detalhes em “Saiba mais”.
templ Garantias(cfg Config) {
	<div class="garantias">
		<p>
			<strong>Este canal é anônimo.</strong>
			if cfg.RepoURL != "" {
				Não pedimos seu nome, não guardamos seu IP, apagamos os metadados dos arquivos, e o código está aberto no <a href={ templ.SafeURL(cfg.RepoURL) } target="_blank" rel="noopener noreferrer">GitHub</a>.
			} else {
				Não pedimos seu nome, não guardamos seu IP e apagamos os metadados dos arquivos.
			}
		</p>
		<details>
			<summary>Saiba mais</summary>
			<ul>
				<li>Não pedimos nome, e-mail nem login, e o canal não usa cookie.</li>
				<li>Não guardamos o seu IP, o seu navegador nem a hora do envio: só a data.</li>
				<li>Fotos (JPG, PNG e WebP) são refeitas aqui e ficam só os pixels. Modelo do celular, localização e data da foto são apagados.</li>
				<li>
					Vídeos e áudios do celular (MP4, MOV, M4A, MP3) perdem a localização, o modelo do aparelho e a data da gravação.
					Documentos do Word, Excel, PowerPoint e LibreOffice, PDF e GIF perdem o autor, quem comentou ou alterou, a
					empresa, os caminhos do computador, as datas e o EXIF das fotos coladas neles.
				</li>
				<li>
					<strong>O que fica:</strong> o conteúdo. A sua voz num áudio, o que aparece num vídeo, um nome escrito no
					documento, uma assinatura escaneada. Outros tipos de arquivo (ZIP, HEIC, vídeo de drone ou câmera de ação),
					PDF com senha e documento acima de 128 MB vão como estão e podem levar o seu nome ou a localização. Se puder,
					mande um print ou uma foto da tela no lugar.
				</li>
				if cfg.EntregaHora >= 0 {
					<li>
						Todo dia, a partir das { strconv.Itoa(cfg.EntregaHora) }h, as denúncias dos dias anteriores são enviadas ao sistema
						interno da empresa, só com a data, e apagadas daqui. Lá, só a administração lê.
					</li>
				} else {
					<li>As denúncias ficam guardadas aqui, e só a administração lê.</li>
				}
				if cfg.RepoURL != "" {
					<li>
						O código deste canal é aberto: <a href={ templ.SafeURL(cfg.RepoURL) } target="_blank" rel="noopener noreferrer">{ cfg.RepoURL }</a>.
						Qualquer pessoa pode conferir que ele faz só o que está escrito aqui.
					</li>
				}
				<li>
					Para ficar ainda mais seguro: use o seu celular pessoal, fora do Wi-Fi da empresa, e não escreva detalhes
					que só você saberia. Não há protocolo nem acompanhamento: depois de enviada, ninguém consegue ligar a
					denúncia a você, nem você.
				</li>
			</ul>
		</details>
	</div>
}

templ Recebida() {
	<div class="ok" role="status">
		<strong>Denúncia recebida.</strong>
		<p>Obrigado. A administração vai analisar. Não guardamos nada que ligue esta denúncia a você.</p>
		<p><a href="/">Enviar outra</a></p>
	</div>
}

// RecebidaPage é a resposta para quem enviou sem JavaScript (o formulário comum).
templ RecebidaPage(cfg Config) {
	@base("Canal de denúncia · " + cfg.Empresa) {
		<h1>Canal de denúncia · { cfg.Empresa }</h1>
		@Recebida()
	}
}

// --- painel do admin ---

templ admin(title string) {
	@base(title + " · Denúncias") {
		<nav>
			<a href="/admin">Denúncias</a>
			<a href="/" target="_blank">Página pública</a>
		</nav>
		<p id="flash" role="status"></p>
		{ children... }
	}
}

templ PainelPage(list []store.Denuncia, status string) {
	@admin("Painel") {
		<h1>Denúncias</h1>
		<label for="status">Status</label>
		<select id="status" name="status" hx-get="/admin" hx-target="#lista" hx-trigger="change">
			<option value="" selected?={ status == "" }>Todas</option>
			for _, o := range store.Status {
				<option value={ o.Valor } selected?={ status == o.Valor }>{ o.Rotulo }</option>
			}
		</select>
		<div id="lista">
			@Lista(list)
		</div>
	}
}

templ Lista(list []store.Denuncia) {
	if len(list) == 0 {
		<p class="muted">Nenhuma denúncia.</p>
	} else {
		<table>
			<thead><tr><th>Data</th><th>Assunto</th><th>Status</th><th>Imagens</th><th></th></tr></thead>
			<tbody>
				for _, d := range list {
					<tr>
						<td>{ dataBR(d.RecebidaEm) }</td>
						<td>{ rotuloCategoria(d.Categoria) }</td>
						<td>{ rotuloStatus(d.Status) }</td>
						<td>{ strconv.Itoa(len(d.Anexos)) }</td>
						<td><a href={ templ.SafeURL("/admin/denuncias/" + d.ID) }>Abrir</a></td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ DetalhePage(d store.Denuncia) {
	@admin(rotuloCategoria(d.Categoria)) {
		<h1>{ rotuloCategoria(d.Categoria) }</h1>
		<p class="muted">Recebida em { dataBR(d.RecebidaEm) } (só a data é guardada)</p>
		<div class="descricao">{ d.Descricao }</div>
		if len(d.Anexos) > 0 {
			<div class="anexos">
				for _, a := range d.Anexos {
					if ehImagem(a) {
						<a href={ templ.SafeURL("/admin/arquivos/" + a.ID) } target="_blank"><img src={ "/admin/arquivos/" + a.ID } alt="Imagem da denúncia"/></a>
					} else {
						<p>
							<a href={ templ.SafeURL("/admin/arquivos/" + a.ID) }>{ nomeDoAnexo(a) }</a>
							if a.Limpo {
								<small>({ tamanhoLegivel(a.Tamanho) }, metadados removidos pelo canal)</small>
							} else {
								<small>({ tamanhoLegivel(a.Tamanho) }, veio como foi enviado e pode conter metadados de quem o criou)</small>
							}
						</p>
					}
				}
			</div>
		}
		<form hx-put={ "/admin/denuncias/" + d.ID } hx-target="#flash">
			<label for="status">Status</label>
			<select id="status" name="status">
				for _, o := range store.Status {
					<option value={ o.Valor } selected?={ d.Status == o.Valor }>{ o.Rotulo }</option>
				}
			</select>
			<label for="parecer">Parecer (interno)</label>
			<textarea id="parecer" name="parecer" maxlength={ strconv.Itoa(store.ParecerMax) }>{ d.Parecer }</textarea>
			if d.AtualizadaEm != "" {
				<small>Alterada pela administração em { d.AtualizadaEm }</small>
			}
			<div><button type="submit">Salvar</button></div>
		</form>
	}
}
