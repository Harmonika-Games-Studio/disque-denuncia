package web

import (
	"strconv"

	"disque-denuncia/internal/store"
)

templ base(title string) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="referrer" content="no-referrer"/>
			<title>{ title }</title>
			<meta name="htmx-config" content={ htmxConfig }/>
			<script src="/static/htmx.min.js"></script>
			<style>
				:root {
					color-scheme: dark;
					--fundo: #0A0A0F; --cartao: #0D0D14; --superficie: #13131A; --elevado: #1C1C27;
					--borda: #2D2D3D; --borda-clara: #3D3D50;
					--texto: #F1F5F9; --texto-sec: #94A3B8; --texto-mudo: #6B7280;
					--laranja: #F97316; --laranja-forte: #EA580C;
					--verde: #22C55E; --vermelho: #EF4444;
				}
				* { box-sizing: border-box; }
				body { font: 15px/1.6 Inter, system-ui, -apple-system, "Segoe UI", sans-serif; max-width: 42rem; margin: 0 auto; padding: 2.5rem 1rem; background: var(--fundo); color: var(--texto); }
				h1 { font-size: 1.35rem; font-weight: 600; margin: 0 0 1.25rem; padding-left: .75rem; border-left: 3px solid var(--laranja); }
				h2 { font-size: 1.1rem; font-weight: 600; }
				a { color: var(--laranja); }
				a:hover { color: var(--laranja-forte); }
				nav { display: flex; gap: 1rem; margin-bottom: 1.25rem; }
				table { width: 100%; border-collapse: collapse; }
				td, th { padding: .55rem .5rem; border-bottom: 1px solid var(--borda); text-align: left; vertical-align: top; }
				th { color: var(--texto-sec); font-weight: 500; font-size: .85rem; }
				label { display: block; font-weight: 500; font-size: .9rem; color: var(--texto-sec); margin: 1.1rem 0 .35rem; }
				select, textarea, input[type=file] { width: 100%; padding: .55rem .7rem; font: inherit; color: var(--texto); background: var(--superficie); border: 1px solid var(--borda); border-radius: 8px; }
				select:focus, textarea:focus, input:focus, button:focus-visible, summary:focus-visible { outline: 1px solid var(--laranja); outline-offset: 0; border-color: var(--laranja); }
				textarea { min-height: 12rem; resize: vertical; }
				fieldset { border: 0; padding: 0; margin: 0; }
				legend { padding: 0; font-weight: 500; font-size: .9rem; color: var(--texto-sec); margin: 1.1rem 0 .35rem; }
				label.opcao { display: flex; gap: .6rem; align-items: flex-start; margin: .5rem 0; font-weight: 400; font-size: .95rem; color: var(--texto); cursor: pointer; }
				label.opcao input { margin: .3rem 0 0; accent-color: var(--laranja); }
				option { background: var(--superficie); color: var(--texto); }
				input[type=file]::file-selector-button { font: inherit; color: var(--texto); background: var(--elevado); border: 1px solid var(--borda-clara); border-radius: 6px; padding: .3rem .8rem; margin-right: .8rem; cursor: pointer; }
				button { margin-top: 1.25rem; padding: .6rem 1.3rem; font: inherit; font-weight: 600; color: #fff; background: var(--laranja); border: 0; border-radius: 8px; cursor: pointer; }
				button:hover { background: var(--laranja-forte); }
				button:disabled { opacity: .5; cursor: wait; }
				#flash:empty { display: none; }
				#flash { padding: .7rem .9rem; margin: 0 0 1rem; color: #FCA5A5; background: rgba(239, 68, 68, .08); border: 1px solid rgba(239, 68, 68, .4); border-radius: 8px; }
				.garantias { background: var(--cartao); border: 1px solid var(--borda); border-radius: 8px; padding: 1rem 1.15rem; margin-bottom: 1.5rem; }
				.garantias p { margin: 0; }
				.garantias ul { margin: .75rem 0 0; padding-left: 1.2rem; color: var(--texto-sec); }
				.garantias li { margin: .4rem 0; }
				details { margin-top: .75rem; }
				summary { cursor: pointer; color: var(--laranja); font-weight: 600; font-size: .9rem; }
				#progresso { margin-top: 1rem; display: flex; gap: .7rem; align-items: center; color: var(--texto-sec); font-size: .9rem; }
				#progresso[hidden] { display: none; }
				#progresso progress { flex: 1; height: .5rem; accent-color: var(--laranja); }
				.ok { background: rgba(34, 197, 94, .06); border: 1px solid rgba(34, 197, 94, .35); border-radius: 8px; padding: 1rem 1.15rem; }
				.descricao { white-space: pre-wrap; background: var(--superficie); border: 1px solid var(--borda); border-radius: 8px; padding: .9rem; }
				.anexos img { max-width: 100%; margin: .5rem 0; border: 1px solid var(--borda); border-radius: 8px; }
				small, .muted { color: var(--texto-mudo); }
			</style>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ Flash(msg string) {
	{ msg }
}

// --- página pública ---

templ FormularioPage(cfg Config) {
	@base("Canal de denúncia · " + cfg.Empresa) {
		<h1>Canal de denúncia · { cfg.Empresa }</h1>
		@Garantias(cfg)
		<div id="canal">
			<p id="flash" role="alert"></p>
			<form
				id="form-denuncia"
				action="/denuncias"
				method="post"
				enctype="multipart/form-data"
				data-max-total={ strconv.Itoa(store.MaxTotal) }
				data-max-arquivos={ strconv.Itoa(store.MaxArquivos) }
				data-max-rotulo={ store.RotuloTamanho(store.MaxTotal) }
			>
				<label for="categoria">Assunto</label>
				<select id="categoria" name="categoria" required>
					<option value="">Escolha…</option>
					for _, c := range store.Categorias {
						<option value={ c.Valor }>{ c.Rotulo }</option>
					}
				</select>
				<label for="descricao">O que aconteceu?</label>
				<textarea
					id="descricao"
					name="descricao"
					required
					minlength={ strconv.Itoa(store.DescricaoMin) }
					maxlength={ strconv.Itoa(store.DescricaoMax) }
				></textarea>
				<label for="arquivos">Arquivos: </label>
				<input id="arquivos" type="file" name="arquivos" multiple/>
				if cfg.EntregaHora >= 0 {
					@QuandoEnviar(cfg)
				}
				<div id="progresso" hidden>
					<progress max="100" value="0"></progress>
					<span></span>
				</div>
				<button type="submit">Enviar denúncia</button>
			</form>
		</div>
		<script src="/static/canal.js"></script>
	}
}

// QuandoEnviar é a escolha de quem denuncia: o padrão conta menos (só a data chega
// ao HarmonikaOS); "agora" é mais rápido e conta a hora aproximada.
templ QuandoEnviar(cfg Config) {
	<fieldset>
		<legend>Quando enviar para a administração?</legend>
		<label class="opcao">
			<input type="radio" name="quando" value="dia_seguinte" checked/>
			<span>No dia seguinte, a partir das { strconv.Itoa(cfg.EntregaHora) }h (mais anônimo)</span>
		</label>
		<label class="opcao">
			<input type="radio" name="quando" value="agora"/>
			<span>Agora</span>
		</label>
	</fieldset>
}

// Garantias é o que o canal promete, em uma frase, com os detalhes em “Saiba mais”.
templ Garantias(cfg Config) {
	<div class="garantias">
		<p>
			<strong>Este canal é anônimo.</strong>
			if cfg.RepoURL != "" {
				Não pedimos seu nome, não guardamos seu IP, apagamos os metadados dos arquivos, e o código está aberto no <a href={ templ.SafeURL(cfg.RepoURL) } target="_blank" rel="noopener noreferrer">GitHub</a>.
			} else {
				Não pedimos seu nome, não guardamos seu IP e apagamos os metadados dos arquivos.
			}
		</p>
		<details>
			<summary>Saiba mais</summary>
			<ul>
				<li>Não pedimos nome, e-mail nem login, e o canal não usa cookies.</li>
				<li>Não guardamos o seu IP, o seu navegador nem a hora do envio, somente o dia de envio.</li>
				<li>Fotos, vídeos, áudios, PDF e documentos do Office são limpos dos metadados, como o modelo do celular, localização, data da foto e autor do documento.</li>
				<li>Arquivos .zip são reabertos aqui: cada arquivo de dentro perde o nome e é limpo também. Outros tipos de arquivos podem conter resquicios.</li>
				if cfg.EntregaHora >= 0 {
					<li>
						Você escolhe quando a denúncia vai para o HarmonikaOS: no dia seguinte, a partir das { strconv.Itoa(cfg.EntregaHora) }h, junto com as outras do dia,
						ou agora, em poucos minutos (aí o horário em que ela chega mostra mais ou menos quando você enviou). Depois de enviada, ela é apagada daqui.
					</li>
				} else {
					<li>As denúncias ficam guardadas aqui, e só a administração lê.</li>
				}
				if cfg.RepoURL != "" {
					<li>
						O código deste canal é aberto: <a href={ templ.SafeURL(cfg.RepoURL) } target="_blank" rel="noopener noreferrer">{ cfg.RepoURL }</a>.
						Qualquer pessoa pode conferir os mecanismos de anônimo.
					</li>
				}
				<li>
					Para garantir mais segurança use o seu celular pessoal fora do Wi-Fi da empresa e não escreva detalhes
					que só você saberia. Depois de enviada, ninguém consegue ligar a denúncia a você.
				</li>
			</ul>
		</details>
	</div>
}

templ Recebida() {
	<div class="ok" role="status">
		<strong>Denúncia recebida.</strong>
		<p>Obrigado. A administração vai analisar.</p>
		<p><a href="/">Enviar outra</a></p>
	</div>
}

// RecebidaPage é a resposta para quem enviou sem JavaScript (o formulário comum).
templ RecebidaPage(cfg Config) {
	@base("Canal de denúncia · " + cfg.Empresa) {
		<h1>Canal de denúncia · { cfg.Empresa }</h1>
		@Recebida()
	}
}

// --- painel do admin ---

templ admin(title string) {
	@base(title + " · Denúncias") {
		<nav>
			<a href="/admin">Denúncias</a>
			<a href="/" target="_blank">Página pública</a>
		</nav>
		<p id="flash" role="status"></p>
		{ children... }
	}
}

templ PainelPage(list []store.Denuncia, status string) {
	@admin("Painel") {
		<h1>Denúncias</h1>
		<label for="status">Status</label>
		<select id="status" name="status" hx-get="/admin" hx-target="#lista" hx-trigger="change">
			<option value="" selected?={ status == "" }>Todas</option>
			for _, o := range store.Status {
				<option value={ o.Valor } selected?={ status == o.Valor }>{ o.Rotulo }</option>
			}
		</select>
		<div id="lista">
			@Lista(list)
		</div>
	}
}

templ Lista(list []store.Denuncia) {
	if len(list) == 0 {
		<p class="muted">Nenhuma denúncia.</p>
	} else {
		<table>
			<thead><tr><th>Data</th><th>Assunto</th><th>Status</th><th>Imagens</th><th></th></tr></thead>
			<tbody>
				for _, d := range list {
					<tr>
						<td>{ dataBR(d.RecebidaEm) }</td>
						<td>{ rotuloCategoria(d.Categoria) }</td>
						<td>{ rotuloStatus(d.Status) }</td>
						<td>{ strconv.Itoa(len(d.Anexos)) }</td>
						<td><a href={ templ.SafeURL("/admin/denuncias/" + d.ID) }>Abrir</a></td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ DetalhePage(d store.Denuncia) {
	@admin(rotuloCategoria(d.Categoria)) {
		<h1>{ rotuloCategoria(d.Categoria) }</h1>
		<p class="muted">Recebida em { dataBR(d.RecebidaEm) } (só a data é guardada)</p>
		<div class="descricao">{ d.Descricao }</div>
		if len(d.Anexos) > 0 {
			<div class="anexos">
				for _, a := range d.Anexos {
					if ehImagem(a) {
						<a href={ templ.SafeURL("/admin/arquivos/" + a.ID) } target="_blank"><img src={ "/admin/arquivos/" + a.ID } alt="Imagem da denúncia"/></a>
					} else {
						<p>
							<a href={ templ.SafeURL("/admin/arquivos/" + a.ID) }>{ nomeDoAnexo(a) }</a>
							if a.Limpo {
								<small>({ tamanhoLegivel(a.Tamanho) }, metadados removidos pelo canal)</small>
							} else {
								<small>({ tamanhoLegivel(a.Tamanho) }, veio como foi enviado e pode conter metadados de quem o criou)</small>
							}
						</p>
					}
				}
			</div>
		}
		<form hx-put={ "/admin/denuncias/" + d.ID } hx-target="#flash">
			<label for="status">Status</label>
			<select id="status" name="status">
				for _, o := range store.Status {
					<option value={ o.Valor } selected?={ d.Status == o.Valor }>{ o.Rotulo }</option>
				}
			</select>
			<label for="parecer">Parecer (interno)</label>
			<textarea id="parecer" name="parecer" maxlength={ strconv.Itoa(store.ParecerMax) }>{ d.Parecer }</textarea>
			if d.AtualizadaEm != "" {
				<small>Alterada pela administração em { d.AtualizadaEm }</small>
			}
			<div><button type="submit">Salvar</button></div>
		</form>
	}
}
